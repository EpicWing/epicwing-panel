# Copy to .env and change the values. Never commit the .env file.

# Datenbank
POSTGRES_USER=forge
POSTGRES_PASSWORD=change-me
POSTGRES_DB=forge
DATABASE_URL=postgresql+psycopg://forge:change-me@localhost:5433/forge

# Backend
EPICWING_ENV=development
# Erzeugen mit: python -c "import secrets; print(secrets.token_urlsafe(48))"
EPICWING_SECRET_KEY=
# Erzeugen mit: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EPICWING_ENCRYPTION_KEY=
# Public address of the panel, e.g. https://panel.example.com (required in production)
EPICWING_PUBLIC_URL=
# Optional: additional allowed origins, comma-separated
EPICWING_ALLOWED_ORIGINS=

# Database connection pool (optional)
# More connections help when many users are online at the same time.
# EPICWING_DB_POOL_SIZE=5
# EPICWING_DB_MAX_OVERFLOW=10
# EPICWING_DB_POOL_RECYCLE=1800
