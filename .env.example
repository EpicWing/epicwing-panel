# Kopieren nach .env und Werte anpassen. Die .env gehört nie ins Repository.

# Datenbank
POSTGRES_USER=forge
POSTGRES_PASSWORD=change-me
POSTGRES_DB=forge
DATABASE_URL=postgresql+psycopg://forge:change-me@localhost:5433/forge

# Backend
FORGE_ENV=development
# Erzeugen mit: python -c "import secrets; print(secrets.token_urlsafe(48))"
FORGE_SECRET_KEY=
# Erzeugen mit: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FORGE_ENCRYPTION_KEY=
# Erlaubte Browser-Origins, kommagetrennt (auch für same-origin POSTs nötig)
FORGE_ALLOWED_ORIGINS=http://localhost:5183
